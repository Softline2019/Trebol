@page "/"
@rendermode InteractiveServer
@layout LoginLayout

@inject IJSRuntime JS
@inject NavigationManager Navigation


@using System.Net.Http
@using System.Net.Http.Json
@using SoftLine.Trebol.WebUI
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using SoftLine.Trebol.Application.Features.Auths.Users.Commands.LoginUser
@using Microsoft.JSInterop
@using SoftLine.Trebol.Application.Features.Auths.Users.Vms
@using SoftLine.Trebol.WebUI.Components.Layout
@inject HttpClient Http
@inject IJSRuntime JS
@inject AuthenticationStateProvider autenticacionProvider
@inject NavigationManager navManager

<PageTitle>Login</PageTitle>

<div class="row mt-5">

    <div class="col-lg-4 offset-lg-4 border">

        <div class="mb-3 text-center">
            <h3>LOGIN</h3>
        </div>

        <div class="mb-3">
            <label>Correo</label>
            <input @bind="@loginModel.Email" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Contraseña</label>
            <input @bind="@loginModel.Password" class="form-control" />
        </div>
        <div class="mb-3">
            <button class="btn btn-primary" @onclick="HandleLogin">Login</button>

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success">@successMessage</div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }
        </div>
    </div>

</div>

